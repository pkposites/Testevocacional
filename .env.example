# Copie para as variáveis de ambiente do Netlify (Site settings → Environment variables).
# Nunca grave valores reais no repositório.
APP_ENV=production
PUBLIC_BASE_URL=https://seu-dominio.com.br
APP_SECRET=                     # 32+ caracteres aleatórios (ex.: openssl rand -base64 48)
DATABASE_URL=                   # Supabase → Connect → Transaction pooler (porta 6543)

OFFER_MODE=free                 # free (nome + WhatsApp liberam o mapa) | paid (checkout Pix)
PAYMENT_PROVIDER=mercadopago    # mercadopago | kiwify
PRODUCT_PRICE_CENTS=1450
CURRENCY=BRL
DELIVERY_MODE=automatic         # automatic | manual
MANUAL_DELIVERY_SLA=até 12 horas

MP_ACCESS_TOKEN=                # credencial de produção (ou TEST- para testes)
MP_WEBHOOK_SECRET=              # assinatura secreta gerada no painel de Webhooks
MP_EXPECTED_USER_ID=            # opcional: ID da conta recebedora
MP_PAYER_EMAIL_TEMPLATE=        # só se o Mercado Pago exigir e-mail do pagador. Ex.: pix+{ref}@seu-dominio.com.br
MP_PIX_EXPIRATION_MINUTES=30

KIWIFY_CHECKOUT_URL=
KIWIFY_WEBHOOK_TOKEN=
KIWIFY_PRODUCT_ID=
KIWIFY_REF_FIELD=TrackingParameters.s1   # confirmar com evento real
KIWIFY_AMOUNT_FIELD=Commissions.charge_amount

# WhatsApp: "none" = sem envio automático (acesso na aba da compra, recuperação com WhatsApp + código,
# admin envia o link pelo próprio WhatsApp). "cloud" = API oficial do WhatsApp (Meta), template aprovado
# com 2 variáveis no corpo: {{1}} primeiro nome, {{2}} link de acesso.
WHATSAPP_PROVIDER=none
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=pt_BR
PURCHASE_LINK_TTL_HOURS=168

SUPPORT_CONTACT=5511999999999   # WhatsApp do suporte com DDI+DDD (ou e-mail)
SELLER_NAME=
SELLER_DOCUMENT=
SELLER_ADDRESS=

META_PIXEL_ID=
META_CAPI_TOKEN=                # opcional: API de Conversões (Purchase no servidor)
META_TEST_EVENT_CODE=

ADMIN_PASSWORD=                 # senha longa para /admin
